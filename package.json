{
  "name": "dhis2-mcp",
  "version": "2.0.0-alpha.1",
  "description": "Connect an AI agent to a DHIS2 development or training instance: one login in a terminal, then the agent works and asks permission before sensitive actions or changes.",
  "main": "dist/index.js",
  "bin": {
    "dhis2-mcp": "dist/cli.js"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "SECURITY-MODEL.md"
  ],
  "scripts": {
    "build": "tsc && node -e \"['dist/index.js','dist/cli.js'].forEach(f=>require('fs').chmodSync(f,'755'))\"",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "jest",
    "test:e2e-security": "tsc --outDir build-e2e && node tests/e2e/stdio-security.mjs build-e2e/index.js && node tests/e2e/stdio-change-engine.mjs build-e2e/index.js && node tests/e2e/install-and-store.mjs build-e2e && node tests/e2e/stdio-transfer.mjs build-e2e/index.js && node tests/e2e/stdio-packages.mjs build-e2e/index.js",
    "login": "node dist/cli.js login",
    "lint": "eslint src/**/*.ts",
    "type-check": "tsc --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "inspector": "npx @modelcontextprotocol/inspector dist/index.js"
  },
  "keywords": [
    "mcp",
    "dhis2",
    "health-information-system",
    "model-context-protocol",
    "code-generator",
    "android-development",
    "web-development",
    "debugging-tools",
    "development-assistant",
    "typescript"
  ],
  "author": "Dradebo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourusername/dhis2-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/dhis2-mcp/issues"
  },
  "homepage": "https://github.com/yourusername/dhis2-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "axios": "^1.20.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^8.0.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
